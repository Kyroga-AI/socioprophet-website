# Full URL (or same-origin path) for the form endpoint that accepts POSTed lead JSON.
# Defaults to "/api/lead" if unset, which relies on the /api/lead rewrite in firebase.json
# routing to the leadCapture Cloud Function in the socioprophet-marketing repo. Only set
# this if the lead-capture service moves to a different host.
# Example: https://api.example.com/leads
VITE_LEAD_ENDPOINT=
