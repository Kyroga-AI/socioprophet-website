{
  "hosting": {
    "site": "socioprophet-marketing",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/products/noetica/beta", "destination": "/products/noetica/beta.html" },
      { "source": "/products/noetica/beta/", "destination": "/products/noetica/beta.html" },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
